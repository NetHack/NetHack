# 전투 메시지 추가 (Additional Combat Messages)
# ============================================================
#: ../src/polyself.c:1282
#, c-format
msgid "%s %s off!"
msgstr "%s{이/가} %s 벗겨졌다!"

#: ../src/polyself.c:1305 ../src/uhitm.c:4945
msgid "release"
msgstr "놓아주다"

#: ../src/polyself.c:1316
#, c-format
msgid "find you must %s %s %s!"
msgstr "%s %s{을/를} %s해야 한다는 것을 알았다!"

#: ../src/polyself.c:1360
msgid "killed while stuck in creature form"
msgstr "그런 생물을 탄다."

#: ../src/polyself.c:1380
#, c-format
msgid "You return to %s form!"
msgstr "%s 형태로 돌아왔다!"

#: ../src/polyself.c:1385
msgid "old form was not healthy enough to survive."
msgstr "이전 형태가 생존하기에 충분히 건강하지 않았다."

#: ../src/polyself.c:1386
#, c-format
msgid "reverting to unhealthy %s form"
msgstr "건강하지 않은 %s 형태로 되돌아감"

#: ../src/polyself.c:1397
#, c-format
