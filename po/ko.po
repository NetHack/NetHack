msgstr ""

#: src/uhitm.c
msgid "venom hits %s harmlessly."
msgstr "독액이 %s{을/를} 해치지 못했다."

#: src/uhitm.c
msgid "venom burns %s!"
msgstr "독액이 %s{을/를} 태웠다!"

#: src/uhitm.c
msgid "You're %s!"
msgstr "%s!"

#: src/uhitm.c
msgid "You're covered in frost!"
msgstr "서리에 뒤덮였다!"

#: src/uhitm.c
msgid "frost doesn't seem cold!"
msgstr "서리가 차갑게 느껴지지 않는다!"

#: src/uhitm.c
msgid "You're covered in %s, but it seems harmless."
msgstr "%s{으로/로} 뒤덮였지만, 해롭지 않은 것 같다."

#: src/uhitm.c
msgid "You're covered in %s!  It burns!"
msgstr "%s{으로/로} 뒤덮였다! 타오른다!"

#: src/uhitm.c
msgid "It burns %s!"
msgstr "%s{을/를} 태웠다!"

#: src/uhitm.c
msgid "purse feels heavier."
msgstr "지갑이 무거워진 것 같다."

#: src/uhitm.c
msgid "grab %s's gold, but find no room in your knapsack."
msgstr "%s의 금화를 집었지만, 배낭에 공간이 없다."

#: src/uhitm.c
msgid "position suddenly seems %suncertain!"
msgstr "위치가 갑자기 %s불확실해진 것 같다!"

#: src/uhitm.c
msgid "very "
msgstr "매우 "

#: src/uhitm.c
msgid "Some writing vanishes from %s head!"
msgstr "%s 머리에서 글씨가 사라졌다!"

#: src/uhitm.c
msgid "Some writing vanishes from your head!"
msgstr "머리에서 글씨가 사라졌다!"

#: src/uhitm.c
msgid "Yuck!"
msgstr "윽!"

#: src/uhitm.c
msgid "The barbs stick to you!"
msgstr "가시가 당신에게 박혔다!"

#: src/uhitm.c
msgid "barbs stick to %s!"
msgstr "가시가 %s{에게} 박혔다!"

#: src/uhitm.c
msgid "Was that the touch of death?"
msgstr "죽음의 손길이었나?"

#: src/uhitm.c
msgid "Lucky for you, it didn't work!"
msgstr "다행히 효과가 없었다!"

#: src/uhitm.c
msgid "It seems harmless to %s."
msgstr "%s{에게} 해롭지 않은 것 같다."

#: src/uhitm.c
msgid "Obviously, you didn't like %s taste."
msgstr "분명히, %s의 맛은 별로였다."

#: src/uhitm.c
msgid "attempt to surround %s is harmless."
msgstr "%s{을/를} 둘러싸려는 시도가 실패했다."

#: src/uhitm.c
msgid "That %s is really %s%c"
msgstr "저 %s{은/는} 사실 %s%c"

#: src/uhitm.c
msgid "The flash of light shines on %s."
msgstr "섬광이 %s{을/를} 비췄다."

#: src/uhitm.c
msgid "charm %s.  %s gladly hands over %s%s possessions."
msgstr "%s{을/를} 매료시켰다. %s{이/가} 기꺼이 %s%s 소지품을 넘겨준다."

#: src/uhitm.c
msgid "seduce %s and %s starts to take off %s clothes."
msgstr "%s{을/를} 유혹했고 %s{이/가} %s 옷을 벗기 시작한다."

#: src/uhitm.c
msgid "poison was deadly..."
msgstr "독이 치명적이었다..."

#: src/uhitm.c
msgid "suck in some slime and don't feel very well."
msgstr "슬라임을 빨아들여 기분이 좋지 않다."

#: src/uhitm.c
msgid "%s %s blocks your attack to %s head."
msgstr "%s %s{이/가} %s 머리에 대한 공격을 막았다."

#: src/uhitm.c
msgid "%s blocks the attack to your head."
msgstr "%s{이/가} 머리에 대한 공격을 막았다."

#: src/uhitm.c
msgid "drown %s..."
msgstr "%s{을/를} 익사시켰다..."

#: src/uhitm.c
msgid "brush against %s."
msgstr "%s{을/를} 스쳤다."

#: src/uhitm.c
msgid "brush against %s %s."
msgstr "%s의 %s{을/를} 스쳤다."

#: src/uhitm.c
msgid "tail"
msgstr "꼬리"

#: src/uhitm.c
msgid "%s is being crushed."
msgstr "%s{이/가} 짓눌리고 있다."

#: src/uhitm.c
msgid "are being crushed."
msgstr "짓눌리고 있다."

#: src/uhitm.c
msgid "are frozen!"
msgstr "얼어붙었다!"

#: src/uhitm.c
msgid "are frozen by %s!"
msgstr "%s에 의해 얼어붙었다!"

#: src/uhitm.c
msgid "are put to sleep!"
msgstr "잠들어버렸다!"

#: src/uhitm.c
msgid "are put to sleep by %s!"
msgstr "%s에 의해 잠들어버렸다!"

#: src/uhitm.c
msgid "turn %s into slime."
msgstr "%s{을/를} 슬라임으로 만들었다."

#: src/uhitm.c
msgid "escape harm."
msgstr "해를 피했다."

#: src/uhitm.c
msgid "are unaffected."
msgstr "영향을 받지 않았다."

#: src/uhitm.c
msgid "don't feel very well."
msgstr "기분이 좋지 않다."

#: src/mhitu.c
msgid "But none comes."
msgstr "하지만 아무도 오지 않는다."

