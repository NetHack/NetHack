msgstr "%s{과/와} 함께 부드럽게 %s{으로/로} 돌아간다."

#: ../src/polyself.c:1410
msgid "breathe.  Sorry."
msgstr "숨쉬다. 미안."

#: ../src/polyself.c:1414
msgid "don't have enough energy to breathe!"
msgstr "숨쉴 에너지가 충분하지 않다!"

#: ../src/polyself.c:1469
#, c-format
msgid "ball and chain are buried firmly in the %s."
msgstr "쇠구슬과 사슬이 %s에 단단히 묻혔다."

#: ../src/polyself.c:1473
