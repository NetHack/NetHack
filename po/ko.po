msgstr "부디, 이 커져가는 갈망을 채워주십시오!"

#: src/sounds.c:772
msgid "I find myself growing a little weary."
msgstr "조금 지쳐가는 것 같습니다."

#: src/sounds.c:777
#, c-format
msgid "Good feeding %s!"
msgstr "%s, 좋은 식사!"

#: src/sounds.c:778
msgid "sister"
msgstr "자매"

#: src/sounds.c:778
msgid "brother"
msgstr "형제"

#: src/sounds.c:781
msgid "How nice to hear you, child of the night!"
msgstr "밤의 아이여, 네 목소리를 들으니 반갑구나!"

#: src/sounds.c:784
msgid "I only drink... potions."
msgstr "난 물약만... 마신다."

#: src/sounds.c:789
msgid "This is my hunting ground that you dare to prowl!"
msgstr "감히 내 사냥터에 발을 들이다니!"

#: src/sounds.c:795
#, c-format
msgid "%s!  Your silver sheen does not frighten me!"
msgstr "%s!  네 은빛 광채는 나를 두렵게 하지 못한다!"

#: src/sounds.c:797
msgid "Fool"
msgstr "어리석은 놈"

#: src/sounds.c:798
msgid "Young Fool"
msgstr "어린 바보"

#: src/sounds.c:803
#, c-format
msgid "I vant to suck your %s!"
msgstr "네 %s를 빨아먹겠다!"

#: src/sounds.c:806
#, c-format
msgid "I vill come after %s without regret!"
msgstr "%s{을/를} 후회 없이 쫓아가겠다!"

#: src/sounds.c:818
#, c-format
msgid "%s throws back %s head and lets out a blood curdling %s!"
msgstr "%s{이/가} %s 머리를 젖히고 소름끼치는 %s{을/를} 내질렀다!"

# sounds.c were messages
#: src/sounds.c:827
msgid "whispers inaudibly.  All you can make out is \"moon\"."
msgstr "알아들을 수 없게 속삭인다.  \"달\"이라는 말만 겨우 알아들었다."

# sounds.c animal sounds
#: src/sounds.c:832
msgid "howls."
msgstr "울부짖는다."

#: src/sounds.c:837
msgid "whines."
msgstr "낑낑거린다."

#: src/sounds.c:839
msgid "yips."
msgstr "깽깽거린다."

#: src/sounds.c:842
msgid "barks."
msgstr "짖는다."

#: src/sounds.c:845
msgid "growls."
msgstr "으르렁거린다."

#: src/sounds.c:853
msgid "yowls."
msgstr "야옹야옹 울어댄다."

#: src/sounds.c:856
msgid "meows."
msgstr "야옹하고 운다."

#: src/sounds.c:859
msgid "purrs."
msgstr "그르렁거린다."

#: src/sounds.c:862
msgid "mews."
msgstr "야옹거린다."

#: src/sounds.c:870 src/sounds.c:874
msgid "snarls."
msgstr "으르렁댄다."

#: src/sounds.c:870
msgid "growls!"
msgstr "으르렁거린다!"

#: src/sounds.c:874
msgid "roars!"
msgstr "포효한다!"

#: src/sounds.c:878
msgid "squeaks."
msgstr "찍찍거린다."

#: src/sounds.c:882
msgid "Nevermore!"
msgstr "다시는 안 돼!"

#: src/sounds.c:885
msgid "squawks."
msgstr "꽥꽥거린다."

#: src/sounds.c:891
msgid "hisses!"
msgstr "쉭쉭 소리를 낸다!"

#: src/sounds.c:898
msgid "drones."
msgstr "윙윙거린다."

#: src/sounds.c:898
msgid "buzzes angrily."
msgstr "화나서 윙윙거린다."

#: src/sounds.c:902 src/sounds.c:985
msgid "grunts."
msgstr "꿀꿀거린다."

#: src/sounds.c:907
msgid "neighs."
msgstr "히힝 운다."

#: src/sounds.c:910
msgid "whinnies."
msgstr "킁킁거린다."

#: src/sounds.c:913
msgid "whickers."
msgstr "부르릉거린다."

#: src/sounds.c:918
msgid "moos."
msgstr "음메 운다."

#: src/sounds.c:924
msgid "bellows!"
msgstr "우렁차게 운다!"

#: src/sounds.c:928
msgid "chirps."
msgstr "짹짹거린다."

#: src/sounds.c:932
msgid "wails mournfully."
msgstr "슬프게 울부짖는다."

#: src/sounds.c:937
msgid "groans."
msgstr "신음한다."

#: src/sounds.c:942 src/sounds.c:992
msgid "gurgles."
msgstr "꿀꺽꿀꺽 소리를 낸다."

#: src/sounds.c:946
msgid "burbles."
msgstr "졸졸 소리를 낸다."

#: src/sounds.c:950
msgid "trumpets!"
msgstr "뿌오하고 운다!"

#: src/sounds.c:955
msgid "shrieks."
msgstr "비명을 지른다."

#: src/sounds.c:959
msgid "imitates you."
msgstr "당신을 흉내낸다."

#: src/sounds.c:963
#, c-format
msgid "%s rattles noisily."
msgstr "%s{이/가} 시끄럽게 덜컹거린다."

#: src/sounds.c:964
msgid "freeze for a moment."
msgstr "잠시 얼어붙었다."

#: src/sounds.c:966
msgid "scared by rattling"
msgstr "덜커덕거리는 소리에 놀람"

#: src/sounds.c:973
msgid "giggles."
msgstr "킥킥거린다."

#: src/sounds.c:974
msgid "chuckles."
msgstr "킬킬거린다."

#: src/sounds.c:975
msgid "snickers."
msgstr "낄낄거린다."

#: src/sounds.c:976
msgid "laughs."
msgstr "웃는다."

#: src/sounds.c:981
msgid "mumbles incomprehensibly."
msgstr "알 수 없는 말을 중얼거린다."

#: src/sounds.c:989
msgid "Sorry, I'm all out of wishes."
msgstr "미안하지만 소원은 다 떨어졌어."

#: src/sounds.c:994
msgid "I'm free!"
msgstr "나는 자유다!"

#: src/sounds.c:997
msgid "This will teach you not to disturb me!"
msgstr "나를 방해하면 어떻게 되는지 가르쳐주마!"

#: src/sounds.c:999
msgid "Get me out of here."
msgstr "여기서 나가게 해줘."

#: src/sounds.c:1006
#, c-format
msgid "%s boasts about %s gem collection."
msgstr "%s{이/가} %s 보석 컬렉션에 대해 자랑한다."

#: src/sounds.c:1010
msgid "complains about a diet of mutton."
msgstr "양고기 식단에 대해 불평한다."

#: src/sounds.c:1013
msgid "shouts \"Fee Fie Foe Foo!\" and guffaws."
msgstr "\"피 파이 포 푸!\"라고 외치며 껄껄 웃는다."

#: src/sounds.c:1026
msgid "threatens you."
msgstr "당신을 위협한다."

#: src/sounds.c:1031
msgid "wants nothing to do with you."
msgstr "당신과 상관하고 싶지 않아한다."

#: src/sounds.c:1033
msgid "moans."
msgstr "신음한다."

#: src/sounds.c:1035
msgid "Huh?"
msgstr "엉?"

#: src/sounds.c:1035
msgid "What?"
msgstr "뭐?"

#: src/sounds.c:1035
msgid "Eh?"
msgstr "응?"

#: src/sounds.c:1037
msgid "I can't see!"
msgstr "앞이 안 보여!"

#: src/sounds.c:1043
msgid "I'm trapped!"
msgstr "갇혀버렸어!"

#: src/sounds.c:1045
msgid "asks for a potion of healing."
msgstr "치료 물약을 달라고 한다."

#: src/sounds.c:1051
msgid "curses orcs."
msgstr "오크를 저주한다."

#: src/sounds.c:1053
msgid "talks about mining."
msgstr "채굴에 대해 이야기한다."

#: src/sounds.c:1055
msgid "talks about spellcraft."
msgstr "주술에 대해 이야기한다."

#: src/sounds.c:1057
msgid "discusses hunting."
msgstr "사냥에 대해 논한다."

#: src/sounds.c:1070
msgid "Phase one, collect underpants."
msgstr "1단계, 속옷을 모아라."

#: src/sounds.c:1071
msgid "Phase three, profit!"
msgstr "3단계, 이익!"

#: src/sounds.c:1073
msgid "Many enter the dungeon, and few return to the sunlit lands."
msgstr "많은 이가 던전에 들어가지만, 햇빛이 비치는 땅으로 돌아오는 이는 적다."

#: src/sounds.c:1086
msgid "complains about unpleasant dungeon conditions."
msgstr "불쾌한 던전 환경에 대해 불평한다."

#: src/sounds.c:1087
msgid "asks you about the One Ring."
msgstr "절대반지에 대해 묻는다."

#: src/sounds.c:1091
msgid "describes a recent article in \"Spelunker Today\" magazine."
msgstr "\"오늘의 탐험가\" 잡지의 최근 기사에 대해 설명한다."

#: src/sounds.c:1094
msgid "Aloha."
msgstr "알로하."

#: src/sounds.c:1097
msgid "discusses dungeon exploration."
msgstr "던전 탐험에 대해 논한다."

#: src/sounds.c:1116
msgid "Hello, sailor."
msgstr "안녕, 뱃사람."

#: src/sounds.c:1119
msgid "comes on to you."
msgstr "당신에게 접근한다."

#: src/sounds.c:1122
msgid "cajoles you."
msgstr "당신을 꼬드긴다."

#: src/sounds.c:1128
#, c-format
msgid "Just the facts, %s."
msgstr "사실만, %s."

#: src/sounds.c:1128
msgid "Ma'am"
msgstr "부인"

#: src/sounds.c:1128
msgid "Sir"
msgstr "선생님"

#: src/sounds.c:1132
msgid "Anything you say can be used against you."
msgstr "당신이 하는 모든 말은 법정에서 불리하게 쓰일 수 있습니다."

#: src/sounds.c:1133
msgid "You're under arrest!"
msgstr "체포한다!"

#: src/sounds.c:1134
msgid "Stop in the name of the Law!"
msgstr "법의 이름으로 멈춰라!"

#: src/sounds.c:1149
msgid "It's not too late."
msgstr "아직 늦지 않았다."

#: src/sounds.c:1151
msgid "We're all doomed."
msgstr "우리 모두 끝장이야."

#: src/sounds.c:1155
msgid "seems to mutter a cantrip."
msgstr "주문을 중얼거리는 것 같다."

#: src/sounds.c:1158
msgid "I hate this job!"
msgstr "이 일이 싫어!"

#: src/sounds.c:1160
msgid "Put that weapon away before you hurt someone!"
msgstr "누군가 다치기 전에 그 무기를 치워!"

#: src/sounds.c:1163 src/uhitm.c:4348
msgid "Doc, I can't help you unless you cooperate."
msgstr "선생님, 협조해주시지 않으면 도와드릴 수 없어요."

#: src/sounds.c:1164
msgid "Please undress so I can examine you."
msgstr "진찰할 수 있게 옷을 벗어주세요."

#: src/sounds.c:1166
msgid "Take off your shirt, please."
msgstr "셔츠를 벗어주세요."

#: src/sounds.c:1168
msgid "Relax, this won't hurt a bit."
msgstr "진정해요, 하나도 안 아플 거예요."

#: src/sounds.c:1172 src/vault.c:582
msgid "Please drop that gold and follow me."
msgstr "금화를 떨어뜨리고 따라오세요."

#: src/sounds.c:1174 src/vault.c:558
msgid "Please follow me."
msgstr "따라오세요."

#: src/sounds.c:1180
msgid "What lousy pay we're getting here!"
msgstr "여기 급여가 정말 형편없군!"

#: src/sounds.c:1181
msgid "The food's not fit for Orcs!"
msgstr "이 음식은 오크도 안 먹어!"

#: src/sounds.c:1182
msgid "My feet hurt, I've been on them all day!"
msgstr "발이 아파, 하루 종일 서있었다고!"

#: src/sounds.c:1186
msgid "Resistance is useless!"
msgstr "저항은 쓸모없다!"

#: src/sounds.c:1187
msgid "You're dog meat!"
msgstr "넌 개밥이다!"

#: src/sounds.c:1188
msgid "Surrender!"
msgstr "항복해라!"

#: src/sounds.c:1202
#, c-format
msgid "Ah, so you have a copy of /%s/."
msgstr "아, /%s/을 갖고 있군."

#: src/sounds.c:1206
msgid "  I may have been misquoted there."
msgstr "  거기서 내 말이 잘못 인용됐을 수도 있어."

#: src/sounds.c:1215
msgid "is busy reading a copy of Sandman #8."
msgstr "샌드맨 8호를 열심히 읽고 있다."

#: src/sounds.c:1217
msgid "Who do you think you are, War?"
msgstr "네가 누구라고 생각하나, 전쟁?"

#: src/sounds.c:1264
#, c-format
msgid "As %s, you cannot speak."
msgstr "%s(으)로서 말할 수 없다."

#: src/sounds.c:1269
msgid "speak.  You're choking!"
msgstr "말하다. 숨이 막힌다!"

#: src/sounds.c:1273
msgid "They won't hear you out there."
msgstr "그들은 저 밖에서 당신을 듣지 못할 것이다."

#: src/sounds.c:1277
msgid "speech is unintelligible underwater."
msgstr "수중에서는 말이 알아들을 수 없다."

#: src/sounds.c:1299 src/sounds.c:1337 src/sounds.c:1384 src/sounds.c:1499
#, c-format
msgid "%s seems not to notice you."
msgstr "%s{이/가} 당신을 알아채지 못하는 것 같다."

#: src/sounds.c:1306
#, c-format
msgid "They won't hear you %s there."
msgstr "그들은 %s 거기서 당신을 듣지 못할 것이다."

#: src/sounds.c:1321
msgid "Talking to yourself is a bad habit for a dungeoneer."
msgstr "혼잣말은 던전 탐험가에게 나쁜 습관이다."

#: src/sounds.c:1352
msgid "It's like talking to a wall."
msgstr "벽에 대고 말하는 것과 같다."

#: src/sounds.c:1368
#, c-format
msgid "wall %s"
msgstr "벽 %s"

#: src/sounds.c:1394
#, c-format
msgid "%s is eating noisily."
msgstr "%s{이/가} 시끄럽게 먹고 있다."

#: src/sounds.c:1402
#, c-format
msgid "Any response%s%s %s."
msgstr "어떤 반응%s%s %s."

#: src/sounds.c:1449
#, c-format
msgid "briefly doff your %s."
msgstr "잠깐 %s{을/를} 벗었다."

#: src/sounds.c:1458
#, c-format
msgid "There's no one %s there."
msgstr "그곳에는 %s 아무도 없다."

#: src/sounds.c:1460
msgid "lout here doesn't acknowledge you..."
msgstr "여기 무례한 자가 당신을 인정하지 않는다..."

#: src/sounds.c:1496
#, c-format
msgid "That %screature is ignoring you!"
msgstr "저 %s생물이 당신을 무시하고 있다!"

#: src/sounds.c:1508
#, c-format
msgid "%s waves."
msgstr "%s{이/가} 손을 흔들었다."

#: src/sounds.c:1510
#, c-format
msgid "%s grasps %s %s but can't remove it."
msgstr "%s{이/가} %s %s{을/를} 잡았지만 벗을 수 없다."

#: src/sounds.c:1514
#, c-format
msgid "%s tips %s %s in response."
msgstr "%s{이/가} 응답으로 %s %s{을/를} 기울였다."

#: src/sounds.c:1524
#, c-format
msgid "%s %s%s%s at you..."
msgstr "%s{이/가} 당신에게 %s%s%s..."

#: src/sounds.c:1530
#, c-format
msgid "%s doesn't respond."
msgstr "%s{은/는} 반응하지 않는다."

#: src/spell.c:152
msgid "These runes were just too much to comprehend."
msgstr "이 룬들은 이해하기에 너무 어려웠다."

#: src/spell.c:156
msgid "book was coated with contact poison!"
msgstr "책에 접촉 독이 발라져 있었다!"

#: src/spell.c:172
#, c-format
msgid "book %s, but you are unharmed!"
msgstr "책이 %s했지만, 당신은 다치지 않았다!"

#: src/spell.c:174
#, c-format
msgid "As you read the book, it %s in your %s!"
msgstr "책을 읽는 동안, 그것이 당신의 %s에서 %s!"

#: src/spell.c:198
msgid "accidentally tear the spellbook to pieces."
msgstr "실수로 마법서를 갈기갈기 찢어버렸다."

#: src/spell.c:203
#, c-format
msgid "find yourself reading the %s line over and over again."
msgstr "같은 %s줄을 계속 반복해서 읽고 있는 자신을 발견했다."

#: src/spell.c:236
msgid "turn the pages of the Book of the Dead..."
msgstr "죽음의 책 페이지를 넘긴다..."

#: src/spell.c:254
#, c-format
msgid "A chill runs down your %s."
msgstr "%s에 오한이 흐른다."

#: src/spell.c:257
msgid "a faint chime..."
msgstr "희미한 종소리..."

#: src/spell.c:260
msgid "Vlad's doppelganger is amused."
msgstr "블라드의 도플갱어가 재미있어한다."

#: src/spell.c:282
msgid "invocation fails!"
msgstr "주문이 실패했다!"

#: src/spell.c:285
msgid "At least one of your relics is cursed..."
msgstr "유물 중 적어도 하나가 저주받았다..."

#: src/spell.c:299
#, c-format
msgid "have a feeling that %s is amiss..."
msgstr "%s{이/가} 잘못되었다는 느낌이 든다..."

#: src/spell.c:309
msgid "raised the dead!"
msgstr "죽은 자를 일으켰다!"

#: src/spell.c:329
msgid "ancestors are annoyed with you!"
msgstr "조상들이 당신에게 짜증내고 있다!"

#: src/spell.c:332
msgid "headstones in the cemetery begin to move!"
msgstr "묘지의 비석들이 움직이기 시작한다!"

#: src/spell.c:335
msgid "Oh my!  Your name appears in the book!"
msgstr "이런! 당신의 이름이 책에 나타난다!"

#: src/spell.c:347
#, c-format
msgid "%s shut!"
msgstr "%s{이/가} 닫혔다!"

#: src/spell.c:373 src/spell.c:609 src/spell.c:625
msgid "reading a book"
msgstr "책을 읽는 중"

#: src/spell.c:402
msgid "This spellbook is too faint to be read any more."
msgstr "이 마법서는 더 이상 읽을 수 없을 정도로 희미하다."

#: src/spell.c:408
#, c-format
msgid "knowledge of %s is %s."
msgstr "%s의 지식이 %s."

#: src/spell.c:420
msgid "This spellbook is too faint to read even once."
msgstr "이 마법서는 한 번 읽기에도 너무 희미하다."

#: src/spell.c:432
#, c-format
msgid "learn %s."
msgstr "%s{을/를} 배웠다."

#: src/spell.c:434
#, c-format
msgid "add %s to your repertoire, as '%c'."
msgstr "%s{을/를} '%c'(으)로 레퍼토리에 추가했다."

#: src/spell.c:488
#, c-format
msgid "This book is so dull that you can't keep your %s open."
msgstr "이 책은 너무 지루해서 %s{을/를} 뜨고 있을 수가 없다."

#: src/spell.c:501
#, c-format
msgid "continue your efforts to %s."
msgstr "%s 노력을 계속한다."

#: src/spell.c:507
msgid "This spellbook is all blank."
msgstr "이 마법서는 완전히 비어있다."

#: src/spell.c:566
#, c-format
msgid "know \"%s\" quite well already."
msgstr "\"%s\"{을/를} 이미 잘 알고 있다."

#: src/spell.c:614
msgid "spellbook crumbles to dust!"
msgstr "마법서가 먼지로 부서진다!"

#: src/spell.c:632
#, c-format
msgid "begin to %s the runes."
msgstr "룬을 %s 시작한다."

#: src/spell.c:691
msgid "are too impaired to cast a spell."
msgstr "주문을 시전하기에 너무 손상되어 있다."

#: src/spell.c:694
msgid "are unable to chant the incantation."
msgstr "주문을 외울 수 없다."

#: src/spell.c:704
msgid "arms are not free to cast!"
msgstr "팔이 자유롭지 않아 시전할 수 없다!"

#: src/spell.c:723 src/spell.c:2018
msgid "don't know any spells right now."
msgstr "지금은 아무 주문도 모른다."

#: src/spell.c:761
msgid "That's enough tries."
