msgid "loot anything %sthere with %s in the way."
msgstr "%s{이/가} 막고 있어서 %s거기 있는 것을 약탈할 수 없다."

#: src/pickup.c:2326
msgid "have to be at a container to loot it."
msgstr "약탈하려면 용기 옆에 있어야 한다."

#: src/pickup.c:2329
#, c-format
msgid "%s %s%shere to loot."
msgstr "약탈할 %s%s %s{이/가} 여기 있다."

#: src/pickup.c:2336
#, c-format
msgid "%s %s to loot."
msgstr "약탈할 %s %s."

#: src/pickup.c:2381
msgid "Ok, now there is loot here."
msgstr "좋아, 이제 여기에 약탈품이 있다."

#: src/pickup.c:2398
msgid "Thank you for your contribution to reduce the debt."
msgstr "부채를 줄이는 데 기여해 주셔서 감사합니다."

#: src/pickup.c:2411
msgid "The exchequer accepts your contribution."
msgstr "재무부가 기부금을 받아들인다."

#: src/pickup.c:2444
msgid "do that without limbs."
msgstr "팔다리 없이는 그렇게 할 수 없다."

#: src/pickup.c:2448
#, c-format
msgid "can't.  The saddle seems to be stuck to %s."
msgstr "안 된다. 안장이 %s에 붙어있는 것 같다."

#: src/pickup.c:2456
#, c-format
msgid "take %s off of %s."
msgstr "%s{을/를} %s에서 꺼냈다."

#: src/pickup.c:2562
msgid "must be kidding."
msgstr "농담이겠지."

#: src/pickup.c:2565
msgid "That would be an interesting topological exercise."
msgstr "그것은 흥미로운 위상학적 연습이 될 것이다."

#: src/pickup.c:2573
#, c-format
msgid "stone%s won't leave your person."
msgstr "돌%s{이/가} 몸에서 떨어지지 않는다."

#: src/pickup.c:2583
#, c-format
msgid "%s cannot be confined in such trappings."
msgstr "%s{은/는} 그런 장식에 가둘 수 없다."

#: src/pickup.c:2586
#, c-format
msgid "%s attached to your pet."
msgstr "%s{이/가} 당신의 애완동물에 붙어 있다."

#: src/pickup.c:2614
#, c-format
msgid "cannot fit %s into %s."
msgstr "%s{을/를} %s 안에 넣을 수 없다."

#: src/pickup.c:2656
#, c-format
msgid "As you put %s inside, you are blasted by a magical explosion!"
msgstr "%s{을/를} 안에 넣자, 마법 폭발에 휩싸였다!"

#: src/pickup.c:2692
#, c-format
msgid "put %s into %s."
msgstr "%s{을/를} %s 안에 넣었다."

# ============================================================
# 전투 메시지 추가 (Additional Combat Messages)
# ============================================================
#: src/pickup.c:2804
#, c-format
msgid "%s %s vanished!"
msgstr "%s %s{이/가} 사라졌다!"

#: src/pickup.c:2806
#, c-format
msgid "%s %s disappear!"
msgstr "%s %s{이/가} 사라진다!"

