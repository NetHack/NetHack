msgstr "아무것에도 묶여있지 않다!"

#: ../src/polyself.c:1492
#, c-format
msgid "must be on %s ground to spin a web."
msgstr "거미줄을 치려면 %s 땅 위에 있어야 한다."

#: ../src/polyself.c:1497
#, c-format
msgid "release web fluid inside %s."
msgstr "%s 안에서 거미줄 액을 뿜는다."

#: ../src/polyself.c:1516
msgid "ignites and "
msgstr ", "

#: ../src/polyself.c:1519
msgid "fries and "
msgstr ", "

#: ../src/polyself.c:1522
msgid "freezes, shatters and "
msgstr "아래의 함정문이 산산이 부서졌다."

#: ../src/polyself.c:1525
#, c-format
msgid "web %sis swept away!"
msgstr "거미줄이 %s쓸려갔다!"

#: ../src/polyself.c:1529
#, c-format
msgid "web dissolves into %s."
msgstr "거미줄이 %s{으로/로} 녹는다."

#: ../src/polyself.c:1533
msgid "cannot spin webs while stuck in a trap."
msgstr "함정에 갇혀있는 동안 거미줄을 칠 수 없다."

#: ../src/polyself.c:1541
msgid "spin a web, covering up the pit."
msgstr "거미줄을 쳐서 구덩이를 덮었다."

#: ../src/polyself.c:1547
msgid "squeaky board is muffled."
msgstr "삐걱거리는 판자가 무뎌졌다."

#: ../src/polyself.c:1555
msgid "webbing vanishes!"
msgstr "거미줄이 사라졌다!"

#: ../src/polyself.c:1558
msgid "make the web thicker."
msgstr "거미줄을 더 두껍게 만들었다."

#: ../src/polyself.c:1562
#, c-format
msgid "web over the %s."
msgstr "%s 위에 거미줄을 쳤다."

#: ../src/polyself.c:1568
msgid "spin a web, jamming the trigger."
msgstr "거미줄을 쳐서 발동 장치를 막았다."

#: ../src/polyself.c:1583
msgid "have triggered a trap!"
msgstr "함정을 작동시켰다!"

#: ../src/polyself.c:1592
#, c-format
msgid "web fails to impede access to the %s."
msgstr "거미줄이 %s 접근을 막지 못했다."

#: ../src/polyself.c:1598
msgid "spin a web."
msgstr "거미줄을 쳤다."

#: ../src/polyself.c:1612
msgid "lack the energy to send forth a call for help!"
msgstr "도움을 요청할 에너지가 부족하다!"

#: ../src/polyself.c:1618
msgid "call upon your brethren for help!"
msgstr "동족에게 도움을 요청했다!"

#
#: ../src/polyself.c:1621
msgid "But none arrive."
msgstr "하지만 아무도 오지 않는다."

#: ../src/polyself.c:1646
msgid "see anything to gaze at."
msgstr "응시할 것이 보이지 않는다."

#: ../src/polyself.c:1649
msgid "gaze at anything you can see."
msgstr "보이는 것을 응시했다."

#: ../src/polyself.c:1653
msgid "lack the energy to use your special gaze!"
msgstr "특수 응시를 사용할 에너지가 부족하다!"

#: ../src/polyself.c:1665
#, c-format
msgid "%s seems not to notice your gaze."
msgstr "%s{이/가} 당신의 응시를 알아차리지 못한 것 같다."

# ============================================================
# 던전 메시지 (Dungeon Messages)
# ============================================================
#: ../src/polyself.c:1667
#, c-format
msgid "see where to gaze at %s."
msgstr "%s{을/를} 응시할 곳을 보았다."

#: ../src/polyself.c:1673
#, c-format
msgid "avoid gazing at %s."
msgstr "%s{을/를} 응시하는 것을 피했다."

#: ../src/polyself.c:1676
#, c-format
msgid "Really %s %s?"
msgstr "정말로 저장하시겠습니까?"

#: ../src/polyself.c:1693
#, c-format
msgid "gaze confuses %s!"
msgstr "응시가 %s{을/를} 혼란시켰다!"

#: ../src/polyself.c:1695
#, c-format
msgid "%s is getting more and more confused."
msgstr "%s{이/가} 점점 더 혼란스러워진다."

#: ../src/polyself.c:1701
#, c-format
msgid "attack %s with a fiery gaze!"
msgstr "불꽃 시선으로 %s{을/를} 공격한다!"

#: ../src/polyself.c:1703
#, c-format
msgid "fire doesn't burn %s!"
msgstr "불이 %s{을/를} 태우지 못한다!"

#: ../src/polyself.c:1723 ../src/uhitm.c:6017
#, c-format
msgid "are frozen by %s gaze!"
msgstr "%s의 시선에 얼어붙었다!"

#: ../src/polyself.c:1729
msgid "frozen by a monster's gaze"
msgstr "몬스터의 시선에 얼어붙음"

#: ../src/polyself.c:1733
#, c-format
msgid "stiffen momentarily under %s gaze."
msgstr "%s 시선 아래서 잠시 굳었다."

#: ../src/polyself.c:1742
#, c-format
msgid "Gazing at the awake %s is not a very good idea."
msgstr "깨어있는 %s{을/를} 응시하는 것은 좋은 생각이 아니다."

#: ../src/polyself.c:1755
msgid "gaze at no place in particular."
msgstr "특별한 곳을 응시하지 않았다."

#: ../src/polyself.c:1769
#, c-format
msgid "hide while you're %s."
msgstr "%s 동안 숨을 수 없다."

#: ../src/polyself.c:1774
msgid "holding someone"
msgstr ", 당신을 붙잡는 중"

#: ../src/polyself.c:1775
msgid "holding that creature"
msgstr "여기에 있는 것들:"

#: ../src/polyself.c:1787
msgid "fountain is not deep enough to hide in."
msgstr "분수는 숨기에 충분히 깊지 않다."

#: ../src/polyself.c:1789
#, c-format
msgid "is no %s to hide in here."
msgstr "여기에 숨을 %s{이/가} 없다."

#: ../src/polyself.c:1798
msgid "is nothing to hide under here."
msgstr "여기 숨을 것이 없다."

#: ../src/polyself.c:1819
#, c-format
msgid "Hiding under %s%s is a fatal mistake..."
msgstr "%s%s 아래에 숨는 것은 치명적인 실수다..."

#: ../src/polyself.c:1821
#, c-format
msgid "hiding under %s%s"
msgstr "%s%s 아래에 숨어있음"

#: ../src/polyself.c:1830
msgid "is nowhere to hide above you."
msgstr "위에 숨을 곳이 없다."

#: ../src/polyself.c:1836
msgid "is nowhere to hide beneath you."
msgstr "위에 숨을 곳이 없다."

#: ../src/polyself.c:1868
#, c-format
msgid "transform into %s."
msgstr "%s{으로/로} 변신했다."

#: ../src/polyself.c:1884
msgid "concentrate but lack the energy to maintain doing so."
msgstr "집중하지만 유지할 에너지가 부족하다."

#: ../src/polyself.c:1890
msgid "concentrate."
msgstr "집중한다."

#: ../src/polyself.c:1891
msgid "A wave of psychic energy pours out."
msgstr "정신 에너지의 파동이 쏟아져 나온다."

#: ../src/polyself.c:1912
#, c-format
msgid "lock in on %s %s."
msgstr "%s %s에 고정했다."

#: ../src/polyself.c:1934
#, c-format
msgid "%s is no longer in your clutches."
msgstr "%s{이/가} 더 이상 손아귀에 없다."

#: ../src/polyself.c:1944
msgid "skin returns to its original form."
msgstr "피부가 원래 형태로 돌아왔다."

