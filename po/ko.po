msgid "feel like"
msgstr "나를 풀어줬다!"

#: ../src/polyself.c:807
msgid "You turn to stone!"
msgstr "돌로 변했다..."

#: ../src/polyself.c:832
msgid "You no longer seem to be petrifying."
msgstr "더 이상 석화되지 않는 것 같다."

#
#: ../src/polyself.c:837
msgid "no longer feel sick."
msgstr "더 이상 아프지 않다."

#: ../src/polyself.c:841
msgid "The slime burns away!"
msgstr "슬라임이 불타 사라졌다!"

#: ../src/polyself.c:923
#, c-format
msgid "%s can no longer contain you."
msgstr "%s{이/가} 더 이상 당신을 담을 수 없다."

#: ../src/polyself.c:946
#, c-format
msgid "%s loses its grip on you."
msgstr "%s{이/가} 당신에게서 놓친다."

#: ../src/polyself.c:954
#, c-format
msgid "%s touch %s."
msgstr "%s{이/가} %s{을/를} 만졌다."

#: ../src/polyself.c:976
msgid "rock seems to no longer trap you."
msgstr "바위가 더 이상 가두지 않는 것 같다."

#: ../src/polyself.c:978
msgid "buried ball is no longer bound to you."
msgstr "묻힌 공이 더 이상 묶여있지 않다."

#: ../src/polyself.c:984
#, c-format
msgid "%s now feels soothing."
msgstr "%s{이/가} 이제 편안하게 느껴진다."

#: ../src/polyself.c:990
msgid "slip out of the iron chain."
msgstr "철 사슬에서 빠져나왔다."

#: ../src/polyself.c:993
msgid "slip free of the buried ball and chain."
msgstr "묻힌 공과 사슬에서 빠져나왔다."

#: ../src/polyself.c:1002
#, c-format
msgid "are no longer stuck in the %s."
msgstr "더 이상 %s에 갇혀있지 않다."

#: ../src/polyself.c:1003 ../src/trap.c:1526 ../src/trap.c:5496
msgid "bear trap"
msgstr "곰덫"

#
#: ../src/polyself.c:1008
msgid "orient yourself on the web."
msgstr "거미줄 위에서 방향을 잡았다."

#: ../src/polyself.c:1033
msgid "Use the command #monster to use your breath weapon."
msgstr "브레스 공격을 사용하려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1035
msgid "Use the command #monster to spit venom."
msgstr "독을 뱉으려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1037
msgid "Use the command #monster to remove an iron ball."
msgstr "쇠구슬을 제거하려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1039
msgid "Use the command #monster to gaze at monsters."
msgstr "몬스터를 응시하려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1041
msgid "Use the command #monster to hide or to spin a web."
msgstr "숨거나 거미줄을 치려면 #monster 명령을 사용해라."

#
#: ../src/polyself.c:1043
msgid "Use the command #monster to hide."
msgstr "숨으려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1045
msgid "Use the command #monster to spin a web."
msgstr "거미줄을 치려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1047
msgid "Use the command #monster to summon help."
msgstr "도움을 소환하려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1049
msgid "Use the command #monster to multiply in a fountain."
msgstr "분수에서 번식하려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1051
msgid "Use the command #monster to use your horn."
msgstr "뿔을 사용하려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1053
msgid "Use the command #monster to emit a mental blast."
msgstr "정신 폭발을 방출하려면 #monster 명령을 사용해라."

#
#: ../src/polyself.c:1055
msgid "Use the command #monster to shriek."
msgstr "비명을 지르려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1057
msgid "Use the command #monster to change shape."
msgstr "변신하려면 #monster 명령을 사용해라."

#: ../src/polyself.c:1063
msgid "Use the command #sit to spawn in the water."
msgstr "물에서 산란하려면 #sit 명령을 사용해라."

#: ../src/polyself.c:1064
msgid "Use the command #sit to lay an egg."
msgstr "알을 낳으려면 #sit 명령을 사용해라."

#: ../src/polyself.c:1167
msgid "break out of your armor!"
msgstr "갑옷을 부수고 나왔다!"

#: ../src/polyself.c:1175
#, c-format
msgid "clasp on your %s breaks open!"
msgstr "%s의 걸쇠가 부러졌다!"

#: ../src/polyself.c:1180
msgid "shirt rips to shreds!"
msgstr "셔츠가 갈기갈기 찢어졌다!"

#: ../src/polyself.c:1187
msgid "armor falls around you!"
msgstr "갑옷이 당신 주변으로 떨어졌다!"

#: ../src/polyself.c:1199
#, c-format
msgid "%s falls, unsupported!"
msgstr "%s{이/가} 지지되지 않아 떨어졌다!"

#: ../src/polyself.c:1201
#, c-format
msgid "shrink out of your %s!"
msgstr "%s에서 줄어들어 빠져나왔다!"

#: ../src/polyself.c:1207
msgid "seep right through your shirt!"
msgstr "셔츠를 뚫고 스며든다!"

#: ../src/polyself.c:1209
msgid "become much too small for your shirt!"
msgstr "셔츠에 비해 너무 작아졌다!"

#: ../src/polyself.c:1221
#, c-format
msgid "%s %s through %s."
msgstr "%s{이/가} %s{을/를} %s 통과했다."

#: ../src/polyself.c:1221
msgid "pierce"
msgstr "더 행복하다"

#: ../src/polyself.c:1226 ../src/polyself.c:1252
#, c-format
msgid "%s falls to the %s!"
msgstr "%s{이/가} %s{으로/로} 떨어졌다!"

#: ../src/polyself.c:1238
#, c-format
msgid "drop your gloves%s!"
msgstr "장갑%s{을/를} 떨어뜨렸다!"

#: ../src/polyself.c:1245
msgid "can no longer hold your shield!"
msgstr "더 이상 방패를 들 수 없다!"

#: ../src/polyself.c:1264
msgid "boots fall away!"
msgstr "부츠가 떨어졌다!"

#: ../src/polyself.c:1266
#, c-format
msgid "boots %s off your feet!"
msgstr "부츠가 발에서 %s 벗겨졌다!"

#: ../src/polyself.c:1267 ../src/worn.c:1298
msgid "are pushed"
msgstr "물보라를 맞았다!"

