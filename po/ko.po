#, c-format
msgid "think %s brushed your %s."
msgstr "%s{이/가} 당신의 %s{을/를} 스친 것 같다."

#: src/pickup.c:2850
#, c-format
msgid "%s inside the box is still alive!"
msgstr "상자 안의 %s{이/가} 아직 살아있다!"

#: src/pickup.c:2872
#, c-format
msgid "%s inside the box is dead!"
msgstr "상자 안의 %s{이/가} 죽었다!"

#: src/pickup.c:2979
msgid "must put it down to unlock."
msgstr "열려면 내려놓아야 한다."

#: src/pickup.c:2983
#, c-format
msgid "open %s..."
msgstr "%s{을/를} 열었다..."

#: src/pickup.c:2988
msgid "opening a container"
msgstr "용기를 여는 중"

#: src/pickup.c:3013 src/pickup.c:3811
#, c-format
msgid "owe %ld %s for lost merchandise."
msgstr "잃어버린 상품에 대해 %ld %s{을/를} 빚진다."

#: src/pickup.c:3138
#, c-format
msgid "don't have anything%s to %s."
msgstr "%s할 것이 %s 없다."

#: src/pickup.c:3638
#, c-format
msgid "Some %s %s onto the %s%s."
msgstr "일부 %s{이/가} %s%s 위로 %s."

#: src/pickup.c:3649
#, c-format
msgid "%s %s securely sealed."
msgstr "%s %s{이/가} 단단히 밀봉되어 있다."

#: src/pickup.c:3653
msgid "Nothing interesting happens."
msgstr "흥미로운 일이 일어나지 않았다."

#: src/pickup.c:3729
#, c-format
msgid "%s into %s."
msgstr "%s{이/가} %s 안으로."

#: src/pickup.c:3733
#, c-format
msgid "%s out%c"
msgstr "%s 나왔다%c"

#: src/pickup.c:3762
#, c-format
msgid "As %s %s inside, you are blasted by a magical explosion!"
msgstr "%s{이/가} 안에 %s하자, 마법 폭발에 휩싸였다!"

#: src/pickup.c:3798 src/trap.c:5169
#, c-format
msgid "%s%c"
msgstr "%s%c"

#: src/pickup.c:3870
msgid "Tipping contents to floor only..."
msgstr "바닥에만 내용물을 쏟는다..."

#: src/pickup.c:3968
msgid "tipping a container"
msgstr "용기를 기울이는 중"

#: src/pickup.c:4021
#, c-format
msgid "%sbox is now empty."
msgstr "%s상자가 이제 비었다."

#: src/pline.c:690
#, c-format
msgid "Please report these messages to %s."
msgstr "%s에게 이 메시지를 보고해 주세요."

#: src/pline.c:692
#, c-format
msgid "Alternatively, contact local support: %s"
msgstr "또는 현지 지원에 연락하세요: %s"

# ============================================================
# 전투 메시지 추가 (Additional Combat Messages)
# ============================================================
#: src/polyself.c:180
#, c-format
msgid "%s %s your %s!"
msgstr "%s{이/가} 당신의 %s{을/를} %s!"

#: src/polyself.c:191
msgid "are no longer being strangled."
msgstr "더 이상 목 졸리지 않는다."

#: src/polyself.c:451
msgid "body transforms, but there is still slime on you."
msgstr "몸이 변하지만, 여전히 슬라임이 묻어있다."

#: src/polyself.c:480
msgid "fail to transform!"
msgstr "변신에 실패했다!"

#: src/polyself.c:563 src/read.c:3339
msgid "I've never heard of such monsters."
msgstr "그런 괴물은 들어본 적이 없다."

#: src/polyself.c:565
msgid "polymorph into any of those."
msgstr "그것들 중 하나로 변신한다."

#: src/polyself.c:609
#, c-format
msgid "polymorph into %s."
msgstr "%s{으로/로} 변신한다."

#: src/polyself.c:635
msgid "merge with your scaly armor."
msgstr "비늘 갑옷과 합쳐진다."

#: src/polyself.c:644
#, c-format
msgid "%s reverts to scales as you merge with them."
msgstr "합쳐지면서 %s{이/가} 비늘로 돌아간다."

#: src/polyself.c:740
#, c-format
msgid "rather %s-ish."
msgstr "다소 %s 같다."

#
#: src/polyself.c:836
msgid "no longer feel sick."
msgstr "더 이상 아프지 않다."

#: src/polyself.c:922
#, c-format
msgid "%s can no longer contain you."
msgstr "%s{이/가} 더 이상 당신을 담을 수 없다."

#: src/polyself.c:945
#, c-format
msgid "%s loses its grip on you."
msgstr "%s{이/가} 당신에게서 놓친다."

#: src/polyself.c:953
#, c-format
msgid "%s touch %s."
msgstr "%s{이/가} %s{을/를} 만졌다."

#: src/polyself.c:975
msgid "rock seems to no longer trap you."
msgstr "바위가 더 이상 가두지 않는 것 같다."

#: src/polyself.c:977
msgid "buried ball is no longer bound to you."
msgstr "묻힌 공이 더 이상 묶여있지 않다."

#: src/polyself.c:983
#, c-format
msgid "%s now feels soothing."
msgstr "%s{이/가} 이제 편안하게 느껴진다."

#: src/polyself.c:989
msgid "slip out of the iron chain."
msgstr "철 사슬에서 빠져나왔다."

#: src/polyself.c:992
msgid "slip free of the buried ball and chain."
msgstr "묻힌 공과 사슬에서 빠져나왔다."

#: src/polyself.c:1001
#, c-format
msgid "are no longer stuck in the %s."
msgstr "더 이상 %s에 갇혀있지 않다."

#
#: src/polyself.c:1007
msgid "orient yourself on the web."
msgstr "거미줄 위에서 방향을 잡았다."

#: src/polyself.c:1032
msgid "Use the command #monster to use your breath weapon."
msgstr "브레스 공격을 사용하려면 #monster 명령을 사용해라."

#: src/polyself.c:1034
msgid "Use the command #monster to spit venom."
msgstr "독을 뱉으려면 #monster 명령을 사용해라."

#: src/polyself.c:1036
msgid "Use the command #monster to remove an iron ball."
msgstr "쇠구슬을 제거하려면 #monster 명령을 사용해라."

#: src/polyself.c:1038
msgid "Use the command #monster to gaze at monsters."
msgstr "몬스터를 응시하려면 #monster 명령을 사용해라."

#: src/polyself.c:1040
msgid "Use the command #monster to hide or to spin a web."
msgstr "숨거나 거미줄을 치려면 #monster 명령을 사용해라."

#
#: src/polyself.c:1042
msgid "Use the command #monster to hide."
msgstr "숨으려면 #monster 명령을 사용해라."

#: src/polyself.c:1044
msgid "Use the command #monster to spin a web."
msgstr "거미줄을 치려면 #monster 명령을 사용해라."

#: src/polyself.c:1046
msgid "Use the command #monster to summon help."
msgstr "도움을 소환하려면 #monster 명령을 사용해라."

#: src/polyself.c:1048
msgid "Use the command #monster to multiply in a fountain."
msgstr "분수에서 번식하려면 #monster 명령을 사용해라."

#: src/polyself.c:1050
msgid "Use the command #monster to use your horn."
msgstr "뿔을 사용하려면 #monster 명령을 사용해라."

#: src/polyself.c:1052
msgid "Use the command #monster to emit a mental blast."
msgstr "정신 폭발을 방출하려면 #monster 명령을 사용해라."

#
#: src/polyself.c:1054
msgid "Use the command #monster to shriek."
msgstr "비명을 지르려면 #monster 명령을 사용해라."

#: src/polyself.c:1056
msgid "Use the command #monster to change shape."
msgstr "변신하려면 #monster 명령을 사용해라."

#: src/polyself.c:1062
msgid "Use the command #sit to spawn in the water."
msgstr "물에서 산란하려면 #sit 명령을 사용해라."

#: src/polyself.c:1063
msgid "Use the command #sit to lay an egg."
msgstr "알을 낳으려면 #sit 명령을 사용해라."

#: src/polyself.c:1166
msgid "break out of your armor!"
msgstr "갑옷을 부수고 나왔다!"

#: src/polyself.c:1174
#, c-format
msgid "clasp on your %s breaks open!"
msgstr "%s의 걸쇠가 부러졌다!"

#: src/polyself.c:1179
msgid "shirt rips to shreds!"
msgstr "셔츠가 갈기갈기 찢어졌다!"

#: src/polyself.c:1186
msgid "armor falls around you!"
msgstr "갑옷이 당신 주변으로 떨어졌다!"

#: src/polyself.c:1198
#, c-format
msgid "%s falls, unsupported!"
msgstr "%s{이/가} 지지되지 않아 떨어졌다!"

#: src/polyself.c:1200
#, c-format
msgid "shrink out of your %s!"
msgstr "%s에서 줄어들어 빠져나왔다!"

#: src/polyself.c:1206
msgid "seep right through your shirt!"
msgstr "셔츠를 뚫고 스며든다!"

#: src/polyself.c:1208
msgid "become much too small for your shirt!"
msgstr "셔츠에 비해 너무 작아졌다!"

#: src/polyself.c:1220
#, c-format
msgid "%s %s through %s."
msgstr "%s{이/가} %s{을/를} %s 통과했다."

#: src/polyself.c:1225 src/polyself.c:1251
#, c-format
msgid "%s falls to the %s!"
msgstr "%s{이/가} %s{으로/로} 떨어졌다!"

#: src/polyself.c:1237
#, c-format
msgid "drop your gloves%s!"
msgstr "장갑%s{을/를} 떨어뜨렸다!"

#: src/polyself.c:1244
msgid "can no longer hold your shield!"
msgstr "더 이상 방패를 들 수 없다!"

#: src/polyself.c:1263
msgid "boots fall away!"
msgstr "부츠가 떨어졌다!"

#: src/polyself.c:1265
#, c-format
msgid "boots %s off your feet!"
msgstr "부츠가 발에서 %s 벗겨졌다!"

# ============================================================
# 전투 메시지 추가 (Additional Combat Messages)
# ============================================================
#: src/polyself.c:1281
#, c-format
msgid "%s %s off!"
msgstr "%s{이/가} %s 벗겨졌다!"

#: src/polyself.c:1315
#, c-format
msgid "find you must %s %s %s!"
msgstr "%s %s{을/를} %s해야 한다는 것을 알았다!"

#: src/polyself.c:1384
msgid "old form was not healthy enough to survive."
msgstr "이전 형태가 생존하기에 충분히 건강하지 않았다."

#: src/polyself.c:1396
#, c-format
msgid "and %s return gently to the %s."
msgstr "%s{과/와} 함께 부드럽게 %s{으로/로} 돌아간다."

#: src/polyself.c:1409
msgid "breathe.  Sorry."
msgstr "숨쉬다. 미안."

#: src/polyself.c:1413
msgid "don't have enough energy to breathe!"
msgstr "숨쉴 에너지가 충분하지 않다!"

#: src/polyself.c:1468
#, c-format
msgid "ball and chain are buried firmly in the %s."
msgstr "쇠구슬과 사슬이 %s에 단단히 묻혔다."

#: src/polyself.c:1472
msgid "are not chained to anything!"
msgstr "아무것에도 묶여있지 않다!"

#: src/polyself.c:1491
#, c-format
msgid "must be on %s ground to spin a web."
msgstr "거미줄을 치려면 %s 땅 위에 있어야 한다."

#: src/polyself.c:1496
#, c-format
msgid "release web fluid inside %s."
msgstr "%s 안에서 거미줄 액을 뿜는다."

#: src/polyself.c:1524
#, c-format
msgid "web %sis swept away!"
msgstr "거미줄이 %s쓸려갔다!"

#: src/polyself.c:1528
#, c-format
msgid "web dissolves into %s."
msgstr "거미줄이 %s{으로/로} 녹는다."

#: src/polyself.c:1532
msgid "cannot spin webs while stuck in a trap."
msgstr "함정에 갇혀있는 동안 거미줄을 칠 수 없다."

#: src/polyself.c:1540
msgid "spin a web, covering up the pit."
msgstr "거미줄을 쳐서 구덩이를 덮었다."

#: src/polyself.c:1546
msgid "squeaky board is muffled."
msgstr "삐걱거리는 판자가 무뎌졌다."

#: src/polyself.c:1554
msgid "webbing vanishes!"
msgstr "거미줄이 사라졌다!"

#: src/polyself.c:1557
msgid "make the web thicker."
msgstr "거미줄을 더 두껍게 만들었다."

#: src/polyself.c:1561
#, c-format
msgid "web over the %s."
msgstr "%s 위에 거미줄을 쳤다."

#: src/polyself.c:1567
msgid "spin a web, jamming the trigger."
msgstr "거미줄을 쳐서 발동 장치를 막았다."

#: src/polyself.c:1582
msgid "have triggered a trap!"
msgstr "함정을 작동시켰다!"

#: src/polyself.c:1591
#, c-format
msgid "web fails to impede access to the %s."
msgstr "거미줄이 %s 접근을 막지 못했다."

#: src/polyself.c:1597
msgid "spin a web."
msgstr "거미줄을 쳤다."

#: src/polyself.c:1611
msgid "lack the energy to send forth a call for help!"
msgstr "도움을 요청할 에너지가 부족하다!"

#: src/polyself.c:1617
msgid "call upon your brethren for help!"
msgstr "동족에게 도움을 요청했다!"

#
#: src/polyself.c:1620
msgid "But none arrive."
msgstr "하지만 아무도 오지 않는다."

#: src/polyself.c:1645
msgid "see anything to gaze at."
msgstr "응시할 것이 보이지 않는다."

#: src/polyself.c:1648
msgid "gaze at anything you can see."
msgstr "보이는 것을 응시했다."

#: src/polyself.c:1652
msgid "lack the energy to use your special gaze!"
msgstr "특수 응시를 사용할 에너지가 부족하다!"

#: src/polyself.c:1664
#, c-format
msgid "%s seems not to notice your gaze."
msgstr "%s{이/가} 당신의 응시를 알아차리지 못한 것 같다."

# ============================================================
# 던전 메시지 (Dungeon Messages)
# ============================================================
#: src/polyself.c:1666
#, c-format
msgid "see where to gaze at %s."
msgstr "%s{을/를} 응시할 곳을 보았다."

#: src/polyself.c:1672
#, c-format
msgid "avoid gazing at %s."
msgstr "%s{을/를} 응시하는 것을 피했다."

#: src/polyself.c:1692
#, c-format
msgid "gaze confuses %s!"
msgstr "응시가 %s{을/를} 혼란시켰다!"

#: src/polyself.c:1694
#, c-format
msgid "%s is getting more and more confused."
msgstr "%s{이/가} 점점 더 혼란스러워진다."

#: src/polyself.c:1700
#, c-format
msgid "attack %s with a fiery gaze!"
msgstr "불꽃 시선으로 %s{을/를} 공격한다!"

#: src/polyself.c:1702
#, c-format
msgid "fire doesn't burn %s!"
msgstr "불이 %s{을/를} 태우지 못한다!"

#: src/polyself.c:1722 src/uhitm.c:6016
#, c-format
msgid "are frozen by %s gaze!"
msgstr "%s의 시선에 얼어붙었다!"

#: src/polyself.c:1728
msgid "frozen by a monster's gaze"
msgstr "몬스터의 시선에 얼어붙음"

#: src/polyself.c:1732
#, c-format
msgid "stiffen momentarily under %s gaze."
msgstr "%s 시선 아래서 잠시 굳었다."

#: src/polyself.c:1741
#, c-format
msgid "Gazing at the awake %s is not a very good idea."
msgstr "깨어있는 %s{을/를} 응시하는 것은 좋은 생각이 아니다."

#: src/polyself.c:1754
msgid "gaze at no place in particular."
msgstr "특별한 곳을 응시하지 않았다."

#: src/polyself.c:1768
#, c-format
msgid "hide while you're %s."
msgstr "%s 동안 숨을 수 없다."

#: src/polyself.c:1786
msgid "fountain is not deep enough to hide in."
msgstr "분수는 숨기에 충분히 깊지 않다."

#: src/polyself.c:1788
#, c-format
msgid "is no %s to hide in here."
msgstr "여기에 숨을 %s{이/가} 없다."

#: src/polyself.c:1797
msgid "is nothing to hide under here."
msgstr "여기 숨을 것이 없다."

#: src/polyself.c:1818
#, c-format
msgid "Hiding under %s%s is a fatal mistake..."
msgstr "%s%s 아래에 숨는 것은 치명적인 실수다..."

#: src/polyself.c:1829
msgid "is nowhere to hide above you."
msgstr "위에 숨을 곳이 없다."

#: src/polyself.c:1835
msgid "is nowhere to hide beneath you."
msgstr "아래에 숨을 곳이 없다."

#: src/polyself.c:1867
#, c-format
msgid "transform into %s."
msgstr "%s{으로/로} 변신했다."

#: src/polyself.c:1883
msgid "concentrate but lack the energy to maintain doing so."
msgstr "집중하지만 유지할 에너지가 부족하다."

#: src/polyself.c:1889
msgid "concentrate."
msgstr "집중한다."

#: src/polyself.c:1890
