# NetHack 5.0 - Default settings for the Macintosh port.
# Lines beginning with '#' are comments. Remove the '#' to
# enable an option. See the Guidebook for full documentation.


### Display ###
# NOTE: once the Preferences dialog (File menu) has been used, its saved
# settings override the UI options in this file (tiled_map, fonts and
# sizes, hitpointbar, statuslines). "Forget Settings" in the dialog
# makes this file authoritative again.

# Boulder symbol
#OPTIONS=boulder:0

# Color
OPTIONS=color

# Map display: graphical tiles (the default) or ASCII text. You can switch any
# time in-game with the Tile Mode menu item; this only sets the startup default.
# Tiles need a color-capable screen (>=4-bit); B&W screens always use ASCII.
# Uncomment for ASCII by default even on large color screens:
#OPTIONS=!tiled_map

# Fonts
# Menu uses a monospace font (monaco) so columns line up.
#OPTIONS=font_map:NewHackFont,font_size_map:12
#OPTIONS=font_menu:monaco,font_size_menu:12
#OPTIONS=font_message:PSHackFont,font_size_message:12
#OPTIONS=font_status:monaco,font_size_status:12
#OPTIONS=font_text:geneva,font_size_text:12

# Don't make dark corridors look like lit corridors
OPTIONS=!lit_corridor

