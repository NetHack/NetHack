ifdef CROSS_TO_AMIGA
$(TARGETPFX)tile.o : $(SRCDIR)/tile.c
	$(TARGET_CC) $(TARGET_CFLAGS) -c -o $@ $(SRCDIR)/tile.c
$(TARGETPFX)amidos.o : ../sys/amiga/amidos.c $(HACK_H)
$(TARGETPFX)amirip.o : ../sys/amiga/amirip.c $(HACK_H)
$(TARGETPFX)amistack.o : ../sys/amiga/amistack.c $(HACK_H)
$(TARGETPFX)amiwind.o : ../sys/amiga/amiwind.c \
		../sys/amiga/amimenu.c $(HACK_H)
$(TARGETPFX)winami.o : ../sys/amiga/winami.c $(HACK_H)
$(TARGETPFX)winchar.o : ../sys/amiga/winchar.c $(SRCDIR)/tile.c $(HACK_H)
$(TARGETPFX)winfuncs.o : ../sys/amiga/winfuncs.c $(HACK_H)
$(TARGETPFX)winkey.o : ../sys/amiga/winkey.c $(HACK_H)
$(TARGETPFX)winamenu.o : ../sys/amiga/winamenu.c $(HACK_H)
$(TARGETPFX)winreq.o : ../sys/amiga/winreq.c \
		../sys/amiga/colorwin.c \
		../sys/amiga/clipwin.c $(HACK_H)
$(TARGETPFX)winstr.o : ../sys/amiga/winstr.c $(HACK_H)
$(GAMEBIN) : $(HOBJ) $(LUACROSSLIB)
	$(TARGET_LINK) $(TARGET_LFLAGS) -o $(GAMEBIN) \
	$(HOBJ) $(WINLIB) $(TARGET_LIBS)
#
# Host-side IFF tile conversion tools (run on Linux, produce Amiga IFF files)
#
AMISRC = ../sys/amiga

$(TARGETPFX)xpm2iff_host: $(AMISRC)/xpm2iff_host.c
	$(CC) $(CFLAGS) -o $@ $<
$(TARGETPFX)tomb.iff: $(AMISRC)/grave16.xpm $(TARGETPFX)xpm2iff_host
	$(TARGETPFX)xpm2iff_host $(AMISRC)/grave16.xpm $@

$(TARGETPFX)bmp2iff_host: $(AMISRC)/bmp2iff_host.c
	$(CC) $(CFLAGS) -o $@ $<
$(TARGETPFX)tiles16.iff: ../dat/nhtiles.bmp $(TARGETPFX)bmp2iff_host
	$(TARGETPFX)bmp2iff_host -planes 4 ../dat/nhtiles.bmp $@
$(TARGETPFX)tiles32.iff: ../dat/nhtiles.bmp $(TARGETPFX)bmp2iff_host
	$(TARGETPFX)bmp2iff_host -planes 5 ../dat/nhtiles.bmp $@

AMITILES = $(TARGETPFX)tiles16.iff $(TARGETPFX)tiles32.iff $(TARGETPFX)tomb.iff

AMIREGEX_URL = https://github.com/garyhouston/regex.git
AMIREGEX_SRCDIR = $(AMISRC)/regex

.PHONY: fetch-regex amigapkg amitiles

fetch-regex:
	@DSTDIR=sys/amiga/regex; \
	if [ ! -d src ]; then DSTDIR=../$$DSTDIR; fi; \
	if [ -f $$DSTDIR/regcomp.c ]; then \
	  echo "BSD regex already present"; \
	else \
	  echo "Fetching BSD regex from $(AMIREGEX_URL)"; \
	  tmpdir=$$(mktemp -d) && \
	  git clone --depth 1 $(AMIREGEX_URL) $$tmpdir && \
	  cd $$tmpdir && \
	  sh ./mkh -p regcomp.c > regcomp.ih && \
	  sh ./mkh -p engine.c > engine.ih && \
	  sh ./mkh -p regexec.c > regexec.ih && \
	  sh ./mkh -p regerror.c > regerror.ih && \
	  sh ./mkh -i _REGEX_H_ regex2.h regcomp.c \
	    regexec.c regerror.c regfree.c > regex.h && \
	  cd - > /dev/null && \
	  mkdir -p $$DSTDIR && \
	  for f in regcomp.c regexec.c regerror.c regfree.c \
	    engine.c regex.h regex2.h cclass.h cname.h \
	    utils.h regcomp.ih engine.ih regexec.ih \
	    regerror.ih \
	    COPYRIGHT; do \
	    cp $$tmpdir/$$f $$DSTDIR/; \
	  done && \
	  rm -rf $$tmpdir && \
	  echo "BSD regex installed in $$DSTDIR"; \
	fi
amitiles: $(AMITILES)

amigapkg: $(GAMEBIN) $(AMITILES) ../util/uudecode
	mkdir -p $(TARGETPFX)pkg/NetHack/tiles $(TARGETPFX)pkg/NetHack/hack
	cp $(GAMEBIN) $(TARGETPFX)pkg/NetHack/nethack
	cp ../dat/nhdat $(TARGETPFX)pkg/NetHack/nhdat
	cp ../dat/license $(TARGETPFX)pkg/NetHack/license
	cp ../dat/symbols $(TARGETPFX)pkg/NetHack/symbols
	cp $(TARGETPFX)tiles16.iff $(TARGETPFX)pkg/NetHack/tiles/tiles16.iff
	cp $(TARGETPFX)tiles32.iff $(TARGETPFX)pkg/NetHack/tiles/tiles32.iff
	cp $(TARGETPFX)tomb.iff $(TARGETPFX)pkg/NetHack/tomb.iff
	cp ../doc/nethack.txt $(TARGETPFX)pkg/NetHack/nethack.txt
	( cd $(TARGETPFX)pkg/NetHack && ../../../../util/uudecode ../../../../sys/amiga/amifont8.uu && mv 8 hack/8 )
	( cd $(TARGETPFX)pkg/NetHack && ../../../../util/uudecode ../../../../sys/amiga/amifont.uu )
	cp $(AMISRC)/nethack.cnf $(TARGETPFX)pkg/NetHack/nethack.cnf
	cp $(AMISRC)/README.amiga $(TARGETPFX)pkg/NetHack/README.amiga
	cp $(AMISRC)/amii.hlp $(TARGETPFX)pkg/NetHack/amii.hlp
	( cd $(TARGETPFX)pkg/NetHack && ../../../../util/uudecode ../../../../sys/amiga/NHinfo.uu )
	( cd $(TARGETPFX)pkg/NetHack && ../../../../util/uudecode ../../../../sys/amiga/cnf-info.uu )
	( cd $(TARGETPFX)pkg/NetHack && ../../../../util/uudecode ../../../../sys/amiga/license-info.uu )
	( cd $(TARGETPFX)pkg/NetHack && ../../../../util/uudecode ../../../../sys/amiga/txt-info.uu )
	( cd $(TARGETPFX)pkg/NetHack && ../../../../util/uudecode ../../../../sys/amiga/readme-info.uu )
	( cd $(TARGETPFX)pkg && ../../../util/uudecode ../../../sys/amiga/drawer-info.uu )
	touch $(TARGETPFX)pkg/NetHack/record
	( cd $(TARGETPFX)pkg && zip -9r ../NH$(NHV)AMI$(AMIPKGSEQ).ZIP NetHack NetHack.info )
	@echo amiga package zip file $(TARGETPFX)NH$(NHV)AMI$(AMIPKGSEQ).ZIP
endif  # CROSS_TO_AMIGA

ifdef CROSS_TO_MAC68K
# Mac 68k file dependencies
# mac68kconf.h is pulled in via config.h on MAC68K but the generic
# $(CONFIG_H) timestamp rule only lists pcconf/unixconf/vmsconf/windconf;
# without this extra prerequisite, editing it leaves every core object
# stale (mixed-ABI binary: struct iflags layouts disagree between objects)
$(CONFIG_H): ../include/mac68kconf.h
MAC_H = $(HACK_H) ../sys/mac68k/maccompat.h ../include/macwin.h \
	../include/mactty.h ../include/mttypriv.h
$(TARGETPFX)macmain.o : ../sys/mac68k/macmain.c $(MAC_H)
$(TARGETPFX)macwin.o : ../sys/mac68k/macwin.c $(MAC_H)
$(TARGETPFX)mactty.o : ../sys/mac68k/mactty.c $(MAC_H)
$(TARGETPFX)macmenu.o : ../sys/mac68k/macmenu.c $(MAC_H)
$(TARGETPFX)mttymain.o : ../sys/mac68k/mttymain.c $(MAC_H)
$(TARGETPFX)macfile.o : ../sys/mac68k/macfile.c $(MAC_H)
$(TARGETPFX)maccurs.o : ../sys/mac68k/maccurs.c $(MAC_H)
$(TARGETPFX)macerrs.o : ../sys/mac68k/macerrs.c $(MAC_H)
$(TARGETPFX)mactopl.o : ../sys/mac68k/mactopl.c $(MAC_H)
$(TARGETPFX)macunix.o : ../sys/mac68k/macunix.c $(MAC_H)
$(TARGETPFX)mgetline.o : ../sys/mac68k/mgetline.c $(MAC_H)
$(TARGETPFX)mmodal.o : ../sys/mac68k/mmodal.c
$(TARGETPFX)dprintf.o : ../sys/mac68k/dprintf.c $(MAC_H)
$(TARGETPFX)mactile.o : ../sys/mac68k/mactile.c $(MAC_H) ../sys/mac68k/mactile.h
$(TARGETPFX)macmap.o : ../sys/mac68k/macmap.c $(MAC_H) ../sys/mac68k/macmap.h ../sys/mac68k/mactile.h
# tile.c is the generated glyph-to-tileidx lookup table; tilemap is built
# by util/Makefile and writes to ../src/tile.c.
$(TARGETPFX)tile.o : tile.c
tile.c : ../util/tilemap
	cd ../util && ./tilemap
../util/tilemap :
	cd ../util && $(MAKE) tilemap
# wintty.o, topl.o, getline.o rules are auto-generated by CROSS_SHARED
$(GAMEBIN) : $(HOBJ) $(LUACROSSLIB)
	$(TARGET_LINK) $(TARGET_LFLAGS) -o $(GAMEBIN) \
	$(HOBJ) $(LUACROSSLIB) $(WINLIB) $(TARGET_LIBS)
#
# Recover -- the standalone crash-recovery application (sys/mac68k/mrecover.c).
# Linked without the malloc wrap (it doesn't use the pooling allocator).
$(TARGETPFX)mrecover.o: ../sys/mac68k/mrecover.c
	$(TARGET_CC) $(TARGET_CFLAGS) -o $@ ../sys/mac68k/mrecover.c
$(TARGETPFX)Recover: $(TARGETPFX)mrecover.o
	$(TARGET_LINK) -Wl,-gc-sections -o $@ $(TARGETPFX)mrecover.o -lm -lInterface
#
.PHONY: mac68kpkg
mac68kpkg: $(GAMEBIN) $(TARGETPFX)Recover
	@echo "=== Decoding UI resources ==="
	python3 ../sys/mac68k/tools/decode_hqx.py \
		../sys/mac68k/NHrsrc.hqx $(TARGETPFX)resources \
		--creator-fixup nh31 nh50
	@echo "=== Decoding sound resources ==="
	python3 ../sys/mac68k/tools/decode_hqx.py \
		../sys/mac68k/NHsound.hqx $(TARGETPFX)sounds
	@mkdir -p $(TARGETPFX)sounds/.rsrc
	@cp $(TARGETPFX)sounds/Sounds.rsrc.rsrc $(TARGETPFX)sounds/.rsrc/Sounds
	@touch $(TARGETPFX)sounds/Sounds
	@echo "=== Decoding Recover resources ==="
	python3 ../sys/mac68k/tools/decode_hqx.py \
		../sys/mac68k/mrecover.hqx $(TARGETPFX)recrsrc
	@mkdir -p $(TARGETPFX)recrsrc/.rsrc
	@cp $(TARGETPFX)recrsrc/mrecover.rsrc.rsrc $(TARGETPFX)recrsrc/.rsrc/mrecover
	@touch $(TARGETPFX)recrsrc/mrecover
	@echo "=== Compiling version resource ==="
	$(RETRO68)/bin/Rez ../sys/mac68k/nhvers.r \
		-I $(RETRO68)/multiversal/RIncludes \
		-o $(TARGETPFX)nhvers.rsrc
	@echo "=== Compiling SIZE resource ==="
	$(RETRO68)/bin/Rez ../sys/mac68k/nhsize.r -o $(TARGETPFX)nhsize.rsrc
	@echo "=== Compiling map WIND resources ==="
	$(RETRO68)/bin/Rez ../sys/mac68k/nhmapwind.r \
		-I $(RETRO68)/multiversal/RIncludes \
		-o $(TARGETPFX)nhmapwind.rsrc
	@echo "=== Generating tile PICT resources ==="
	cd ../util && ./tile2pict $(abspath $(TARGETPFX)nhtiles_data.r)
	@echo "=== Compiling tile resource ==="
	$(RETRO68)/bin/Rez ../sys/mac68k/nhtiles_template.r \
		-I $(abspath $(TARGETPFX)) \
		-o $(TARGETPFX)nhtiles.rsrc
	@echo "=== Merging resources (single Rez pass) ==="
	@mkdir -p $(TARGETPFX)resources/.rsrc
	@cp $(TARGETPFX)resources/NetHack.rsrc.rsrc $(TARGETPFX)resources/.rsrc/NHrsrc
	@touch $(TARGETPFX)resources/NHrsrc
	rm -f $(TARGETPFX)NetHackRsrc $(TARGETPFX).rsrc/NetHackRsrc \
		$(TARGETPFX)NetHack.bin
	$(RETRO68)/bin/Rez \
		--copy $(TARGETPFX)NetHack \
		--copy $(TARGETPFX)nhmapwind.rsrc \
		--copy $(TARGETPFX)nhtiles.rsrc \
		--copy $(TARGETPFX)nhsize.rsrc \
		--copy $(TARGETPFX)resources/NHrsrc \
		--copy $(TARGETPFX)sounds/Sounds \
		--copy $(TARGETPFX)nhvers.rsrc \
		--data $(TARGETPFX)NetHack \
		-t APPL -c nh50 \
		-o $(TARGETPFX)NetHack.bin \
		--cc $(TARGETPFX)NetHackRsrc
	@echo "=== Merging Recover resources ==="
	rm -f $(TARGETPFX)RecoverRsrc $(TARGETPFX).rsrc/RecoverRsrc \
		$(TARGETPFX)Recover.bin
	$(RETRO68)/bin/Rez \
		--copy $(TARGETPFX)Recover \
		--copy $(TARGETPFX)recrsrc/mrecover \
		--data $(TARGETPFX)Recover \
		-t APPL -c nhRc \
		-o $(TARGETPFX)Recover.bin \
		--cc $(TARGETPFX)RecoverRsrc
	@echo "=== Staging package files ==="
	@rm -rf $(TARGETPFX)pkg
	@mkdir -p $(TARGETPFX)pkg
	cp $(TARGETPFX)NetHack $(TARGETPFX)pkg/NetHack
	cp $(TARGETPFX).rsrc/NetHackRsrc $(TARGETPFX)pkg/NetHack.rsrc
	python3 ../sys/mac68k/tools/make_info.py NetHack APPL nh50 \
		$(TARGETPFX)pkg/NetHack.info
	cp $(TARGETPFX)Recover $(TARGETPFX)pkg/Recover
	cp $(TARGETPFX).rsrc/RecoverRsrc $(TARGETPFX)pkg/Recover.rsrc
	python3 ../sys/mac68k/tools/make_info.py Recover APPL nhRc \
		$(TARGETPFX)pkg/Recover.info
	cp ../dat/nhdat $(TARGETPFX)pkg/nhdat
	tr '\n' '\r' < ../sys/mac68k/ReadMe.txt > "$(TARGETPFX)pkg/Read Me"
	tr '\n' '\r' < ../dat/license > $(TARGETPFX)pkg/license
	tr '\n' '\r' < ../dat/symbols > $(TARGETPFX)pkg/symbols
	tr '\n' '\r' < ../doc/Guidebook.txt > $(TARGETPFX)pkg/Guidebook
	tr '\n' '\r' < ../sys/mac68k/NHDeflts > "$(TARGETPFX)pkg/NetHack Defaults"
	@echo "=== Building SCSI disk image (emulator/BlueSCSI) ==="
	dd if=/dev/zero of=$(TARGETPFX)nethack_hfs.img bs=1M count=14 2>/dev/null
	hformat -l "NetHack 5.0" $(TARGETPFX)nethack_hfs.img
	hmount $(TARGETPFX)nethack_hfs.img
	hcopy -m $(TARGETPFX)NetHack.bin :
	hcopy -m $(TARGETPFX)Recover.bin :
	hcopy -r $(TARGETPFX)pkg/nhdat :nhdat && hattrib -t DATA -c nh50 nhdat
	hcopy -r "$(TARGETPFX)pkg/Read Me" ":Read Me" && hattrib -t TEXT -c ttxt "Read Me"
	hcopy -r $(TARGETPFX)pkg/license :license && hattrib -t TEXT -c ttxt license
	hcopy -r $(TARGETPFX)pkg/symbols :symbols && hattrib -t TEXT -c nh50 symbols
	hcopy -r $(TARGETPFX)pkg/Guidebook :Guidebook && hattrib -t TEXT -c ttxt Guidebook
	hcopy -r "$(TARGETPFX)pkg/NetHack Defaults" ":NetHack Defaults" && hattrib -t TEXT -c ttxt "NetHack Defaults"
	hcopy -r /dev/null :record && hattrib -t TEXT -c nh50 record
	humount
	python3 ../sys/mac68k/tools/make_scsi_image2.py \
		$(TARGETPFX)nethack_hfs.img \
		$(TARGETPFX)NetHack.img
	rm $(TARGETPFX)nethack_hfs.img
	@echo "=== Creating StuffIt archive (distribution) ==="
	@rm -f $(TARGETPFX)NetHack.sit
	sit -T TEXT -C ttxt -o $(TARGETPFX)NetHack.sit \
		$(TARGETPFX)pkg/NetHack \
		$(TARGETPFX)pkg/Recover \
		$(TARGETPFX)pkg/nhdat \
		$(TARGETPFX)pkg/Guidebook \
		"$(TARGETPFX)pkg/NetHack Defaults" \
		$(TARGETPFX)pkg/license \
		$(TARGETPFX)pkg/symbols \
		"$(TARGETPFX)pkg/Read Me"
	@rm -rf $(TARGETPFX)pkg
	@echo "=== Done ==="
	@echo "SCSI image: $(TARGETPFX)NetHack.img"
	@echo "StuffIt:    $(TARGETPFX)NetHack.sit"
endif  # CROSS_TO_MAC68K

UUDECODE = ../util/uudecode

../util/uudecode: ../sys/share/uudecode.c
	$(CC) $(CFLAGS) -o $@ $<

ifdef CROSS_TO_ATARI
$(TARGETPFX)tos.o : ../sys/atari/tos.c $(HACK_H)
$(TARGETPFX)wingem.o : ../win/gem/wingem.c $(HACK_H)
$(TARGETPFX)wingem1.o : ../win/gem/wingem1.c $(HACK_H)
$(TARGETPFX)bitmfile.o : ../win/gem/bitmfile.c $(HACK_H)
$(TARGETPFX)gr_rect.o : ../win/gem/gr_rect.c $(HACK_H)
$(TARGETPFX)load_img.o : ../win/gem/load_img.c $(HACK_H)
$(GAMEBIN) : $(HOBJ) $(LUACROSSLIB)
	$(TARGET_LINK) $(TARGET_LFLAGS) -o $(GAMEBIN) \
	$(HOBJ) $(WINLIB) $(TARGET_LIBS)

#
# Host-side BMP-to-XIMG converter (runs on Linux, produces Atari .IMG)
#
ATARISRC = ../sys/atari

$(TARGETPFX)bmp2img_host: $(ATARISRC)/bmp2img_host.c
	$(CC) $(CFLAGS) -o $@ $<

$(TARGETPFX)NH16.IMG: ../dat/nhtiles.bmp $(TARGETPFX)bmp2img_host
	$(TARGETPFX)bmp2img_host -planes 4 ../dat/nhtiles.bmp $@
$(TARGETPFX)NH32.IMG: ../dat/nhtiles.bmp $(TARGETPFX)bmp2img_host
	$(TARGETPFX)bmp2img_host -planes 5 ../dat/nhtiles.bmp $@
$(TARGETPFX)NH2.IMG:  ../dat/nhtiles.bmp $(TARGETPFX)bmp2img_host
	$(TARGETPFX)bmp2img_host -atkinson -planes 1 ../dat/nhtiles.bmp $@

ATARITILES = $(TARGETPFX)NH2.IMG $(TARGETPFX)NH16.IMG $(TARGETPFX)NH32.IMG

.PHONY: ataripkg

ataripkg: $(GAMEBIN) ../util/uudecode $(ATARITILES)
	mkdir -p $(TARGETPFX)pkg
	cp $(GAMEBIN) $(TARGETPFX)pkg/nethack.prg
	cp ../dat/nhdat $(TARGETPFX)pkg/nhdat
	cp ../dat/license $(TARGETPFX)pkg/license
	cp ../dat/symbols $(TARGETPFX)pkg/symbols
	cp ../doc/nethack.txt $(TARGETPFX)pkg/nethack.txt
	cp ../sys/atari/README.tos $(TARGETPFX)pkg/README.txt
	cp ../sys/atari/nethack.cnf $(TARGETPFX)pkg/nethack.cnf
	cp ../sys/atari/run-hatari.sh $(TARGETPFX)pkg/run-hatari.sh
	chmod +x $(TARGETPFX)pkg/run-hatari.sh
	cp $(TARGETPFX)NH2.IMG  $(TARGETPFX)pkg/NH2.IMG
	cp $(TARGETPFX)NH16.IMG $(TARGETPFX)pkg/NH16.IMG
	cp $(TARGETPFX)NH32.IMG $(TARGETPFX)pkg/NH32.IMG
	( cd $(TARGETPFX)pkg && ../../../util/uudecode ../../../win/gem/gem_rsc.uu )
	( cd $(TARGETPFX)pkg && ../../../util/uudecode ../../../win/gem/title.uu )
	( cd $(TARGETPFX)pkg && ../../../util/uudecode ../../../win/gem/title2.uu )
	( cd $(TARGETPFX)pkg && ../../../util/uudecode ../../../win/gem/rip.uu )
	touch $(TARGETPFX)pkg/record
	mkdir -p $(TARGETPFX)pkg/levels $(TARGETPFX)pkg/save
	( cd $(TARGETPFX)pkg && zip -9r ../NH500ST.ZIP * )
	@echo atari package zip file $(TARGETPFX)NH500ST.ZIP
endif  # CROSS_TO_ATARI

ifdef CROSS_SHARED
# shared file dependencies
$(TARGETPFX)pcmain.o : ../sys/share/pcmain.c $(HACK_H)
$(TARGETPFX)pcsys.o : ../sys/share/pcsys.c $(HACK_H)
$(TARGETPFX)pctty.o : ../sys/share/pctty.c $(HACK_H)
$(TARGETPFX)pcunix.o : ../sys/share/pcunix.c $(HACK_H)
$(TARGETPFX)tileset.o : ../win/share/tileset.c
$(TARGETPFX)bmptiles.o : ../win/share/bmptiles.c
$(TARGETPFX)giftiles.o : ../win/share/giftiles.c
endif  # CROSS_SHARED
#
ifdef CROSS
ifdef MAKEFILE_TOP
# top-level liblua.a is a host-side build; keep TARGET_CC out of it
LUAMAKEFLAGS = CC='$(CC)' SYSCFLAGS='$(SYSCFLAGS)'
endif  # MAKEFILE_TOP
$(TARGETPFX)hacklib.a: $(TARGETPFX)hacklib.o
	$(TARGET_AR) $(TARGET_ARFLAGS) $@ $(TARGETPFX)hacklib.o
ifdef MAKEFILE_UTL
$(TARGETPFX)recover.o: recover.c $(CONFIG_H)
	$(TARGET_CC) $(TARGET_CFLAGS) -c recover.c -o $@
ifdef CROSS_TO_MSDOS
$(TARGETPFX)recover.exe : $(TARGETPFX)recover.o $(TARGETPFX)rversion.o $(TARGETPFX)hacklib.a
	$(TARGET_LINK) $(TARGET_LFLAGS) \
	$(TARGETPFX)recover.o $(TARGETPFX)rversion.o $(TARGETPFX)hacklib.a -o $@
else
$(TARGETPFX)recover : $(TARGETPFX)recover.o $(TARGETPFX)rversion.o $(TARGETPFX)hacklib.a
	$(TARGET_LINK) $(TARGET_LFLAGS) \
	$(TARGETPFX)recover.o $(TARGETPFX)rversion.o $(TARGETPFX)hacklib.a -o $@
endif
$(TARGETPFX)rversion.o: ../src/version.c $(HACK_H)
	$(TARGET_CC) $(TARGET_CFLAGS) -DMINIMAL_FOR_RECOVER  -c ../src/version.c -o $@
endif  # MAKEFILE_UTL
endif  # CROSS

ifdef BUILD_TARGET_LUA
