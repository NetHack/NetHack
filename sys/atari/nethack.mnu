File
	"Shell"		"!"
	"Options"	"O"
	---
	"Save Game"	"S"
	---
	"Quit"		?"[1][Really quit?][ Yes | No ]":%A"#quit y":!
Edit
	"Copy"		%C
	"Paste"		%P
	"Paste Options..."	%O
	---
	"Set Font..."	%F
Inventory
	"Show Inventory"	"i"
	---
	"Put on jewelry" "P"
	"Remove jewelry" "R"
	"Wear armor"	"W"
	"Take off armor" "T"
	"Wield weapon"	"w"
	"Exchange weapons"	"x"
	"Ready ammo in quiver"	"Q"
	---
	"Eat"		"e"
	"Quaff potion"	"q"
	---
	"Drop"		"d"
	"Throw"		"t"
	"Fire"		"f"
Move
	"North"	"k"	4800
	"South"	"j"	5000
	"East"	"l"	4d00
	"West"	"h"	4b00
	---
	"Rest"	"."
	---
	"Open door" "o"
	"Close door" "c"
Misc
